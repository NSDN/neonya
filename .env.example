# 复制为 .env 后按需修改；.env 不入库。
# Taskfile 会加载 .env；没有 .env 时任务内的默认值等同下面的开发值。

APP_ENV=dev
HTTP_ADDR=:8080
DATABASE_URL=postgres://neonya:neonya@localhost:5432/neonya?sslmode=disable
TEST_DATABASE_URL=postgres://neonya:neonya@localhost:5432/neonya_test?sslmode=disable
SESSION_COOKIE_NAME=neonya_session
STORAGE_DIR=./var/uploads

# 本服务与客户端之间的代理跳数：本地直连填 0（不解析 X-Forwarded-For）；
# 生产在 Nginx 后填 1。填小了客户端可伪造 IP，填大了拿不到 IP。
TRUSTED_PROXY_COUNT=0

# M1 接入 Redis 后再启用。
# REDIS_URL=redis://localhost:6379/0

# 仅供 web 的 Server Component 取数，浏览器一律走相对路径 /api/v1。
# API_BASE_URL=http://localhost:8080
